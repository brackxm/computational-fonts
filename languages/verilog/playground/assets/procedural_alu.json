  "source": "// Copyright 2026 Michael Brackx\n// SPDX-License-Identifier: Apache-2.0\nmodule procedural_alu(input [7:0] a, b, input [1:0] op,\n                      output reg [8:0] y);\n  always @* begin\n    y = 0;\n    case (op)\n      0: y = a + b;\n      1: begin\n        y = a - b;\n        if (a < b) y[8] = 1'b1;\n      end\n      2: y = a ^ b;\n      default: y = {a[3:0], b[3:0]};\n    endcase\n  end\nendmodule\n"
