  "source": "// Build with -P WIDTH=16 to specialize the same circuit to wider input ports.\nmodule parameter_adder #(\n  parameter WIDTH = 8,\n  parameter [WIDTH-1:0] MASK = 8'hA5\n)(input [WIDTH-1:0] a, b,\n  output [WIDTH:0] sum,\n  output [WIDTH-1:0] masked, toggled);\n  localparam [WIDTH-1:0] TOP_BIT = 1'b1 << (WIDTH-1);\n  wire [WIDTH-1:0] mixed = a ^ b, filtered = mixed & MASK;\n  assign sum = a + b;\n  assign masked = filtered;\n  assign toggled = a ^ TOP_BIT;\nendmodule\n",
  "parameters": [
    {
      "name": "WIDTH",
      "value": "8",
      "width": 32,
      "signed": true,
      "local": false
    },
    {
      "name": "MASK",
      "value": "165",
      "width": 8,
      "signed": false,
      "local": false
    },
    {
      "name": "TOP_BIT",
      "value": "128",
      "width": 8,
      "signed": false,
      "local": true
    }
  ]
