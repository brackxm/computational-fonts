  ],
  "source": "// Count the set bits with eight blocking additions, unrolled at compilation.\nmodule population_count(input [7:0] data, output reg [3:0] count);\n  integer i;\n  always @* begin\n    count = 0;\n    for (i = 0; i < 8; i = i + 1)\n      count = count + data[i];\n  end\nendmodule\n"
}
